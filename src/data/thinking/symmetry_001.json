  "title": "対称式 基本",
  "subject": "数学I",
  "unit": "数と式",
  "difficulty": "C",
  "problem": "x + y = 3, xy = 2 のとき、x² + y² の値を求めよ。",
  "triggers": [
    { "id": "t1", "quote": "x + y = 3, xy = 2", "note": "和 x+y と積 xy だけが与えられている" },
    { "id": "t2", "quote": "x² + y²", "note": "x と y を入れ替えても変わらない式（対称式）" }
  ],
  "thoughts": [
    { "id": "n1", "stage": "notice", "from": ["t1", "t2"], "text": "対称式は和と積（基本対称式）で必ず表せる" },
    { "id": "n2", "stage": "strategy", "from": ["n1"], "text": "x² + y² = (x+y)² − 2xy と変形して代入", "adopted": true },
    { "id": "n3", "stage": "strategy", "from": ["n1"], "text": "連立して x, y を個別に求める", "adopted": false, "reason": "解が無理数や虚数になる問題では計算が重く、遠回り" },
    { "id": "n4", "stage": "execute", "from": ["n2"], "text": "3² − 2·2 = 5" }
  ],
